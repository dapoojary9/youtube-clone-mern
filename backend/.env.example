# Port the Express server listens on
PORT=5000
# MongoDB connection string (local instance or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/youtube_clone
# Secret used to sign JWTs - use a long random string in production
JWT_SECRET=replace_with_a_long_random_secret
# How long a login token stays valid
JWT_EXPIRES_IN=7d
# Frontend origin allowed by CORS (comma separated for multiple)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
